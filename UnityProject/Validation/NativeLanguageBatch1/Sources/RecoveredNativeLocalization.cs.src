            case "tr":
                if(owner.textUnlock2!=null) owner.textUnlock2.fontSize=78;
                if(owner.textUnlock2!=null) owner.textUnlock2.resizeTextMaxSize=78;
                break;
            case "pl":
                if(owner.textUnlock2!=null) owner.textUnlock2.fontSize=78;
                if(owner.textUnlock2!=null) owner.textUnlock2.resizeTextMaxSize=78;
                break;
            case "th":
                if(owner.textUnlock2!=null) owner.textUnlock2.fontSize=78;
                if(owner.textUnlock2!=null) owner.textUnlock2.resizeTextMaxSize=78;
                break;
            case "vi":
                if(owner.textUnlock2!=null) owner.textUnlock2.fontSize=78;
                if(owner.textUnlock2!=null) owner.textUnlock2.resizeTextMaxSize=78;
                break;
            case "sv":
                if(owner.textUnlock2!=null) owner.textUnlock2.fontSize=78;
                if(owner.textUnlock2!=null) owner.textUnlock2.resizeTextMaxSize=78;
                break;
            case "el":
                if(owner.textUnlock1!=null && owner.textUnlock1!=null) { Vector2 offset=owner.textUnlock1.rectTransform.offsetMax; offset.y=108.69999694824219f; owner.textUnlock1.rectTransform.offsetMax=offset; }
                break;
            case "id":
                if(owner.textUnlock2!=null) owner.textUnlock2.fontSize=78;
                if(owner.textUnlock2!=null) owner.textUnlock2.resizeTextMaxSize=78;
                break;
            case "ar":
                if(owner.textUnlock2!=null) owner.textUnlock2.fontSize=78;
                if(owner.textUnlock2!=null) owner.textUnlock2.resizeTextMaxSize=78;
                break;
            default: if(owner.textUnlock2!=null) { owner.textUnlock2.fontSize=78; owner.textUnlock2.resizeTextMaxSize=78; } break;
        }
    }
    public static bool DispatchDesigner(string method,Scene scene)
    {
        foreach(var owner in OriginalScenePresentation.Components<UIManagerSelScript0>(scene))
        {
            switch(method) { case "botonDesign0Down": owner.botonDesign0Down(); return true; case "botonDesign1Down": owner.botonDesign1Down(); return true; case "botonDesign2Down": owner.botonDesign2Down(); return true; case "botonDesign3Down": owner.botonDesign3Down(); return true; case "botonDesign4Down": owner.botonDesign4Down(); return true; }
        }
        foreach(var owner in OriginalScenePresentation.Components<UIManagerSelScript>(scene))
        {
            switch(method) { case "botonDesignDown": owner.botonDesignDown(); return true; case "botonDesignDown2": owner.botonDesignDown2(); return true; case "botonDesignDown3": owner.botonDesignDown3(); return true; case "botonDesignSolucion": owner.botonDesignSolucion(); return true; case "botonDesignSolucion2": owner.botonDesignSolucion2(); return true; }
        }
        return false;
    }
}
