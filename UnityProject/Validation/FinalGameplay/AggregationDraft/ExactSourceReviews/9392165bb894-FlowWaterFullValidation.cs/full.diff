+            { var info=typeof(RecoveredBoardFraming).GetField(field,BindingFlags.Instance|BindingFlags.NonPublic); result.framingFields.Add(field+"="+(info==null?"missing":Convert.ToString(info.GetValue(frame)))); }
+            foreach(Renderer renderer in renderers)
