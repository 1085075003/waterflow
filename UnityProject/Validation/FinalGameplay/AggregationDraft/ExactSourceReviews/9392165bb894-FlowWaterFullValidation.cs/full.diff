+                    Vector3 point=camera.WorldToViewportPoint(filter.transform.TransformPoint(vertex));item.vertices++;
+                    item.minDepth=Mathf.Min(item.minDepth,point.z);item.maxDepth=Mathf.Max(item.maxDepth,point.z);
