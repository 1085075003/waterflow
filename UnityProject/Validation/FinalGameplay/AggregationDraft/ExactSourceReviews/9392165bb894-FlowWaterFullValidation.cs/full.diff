+                backward=frame==null?0:frame.LastBackwardDistance,position=camera.transform.position,localPosition=camera.transform.localPosition,
+                euler=camera.transform.eulerAngles,lossyScale=camera.transform.lossyScale,parent=camera.transform.parent==null?"":camera.transform.parent.name};
