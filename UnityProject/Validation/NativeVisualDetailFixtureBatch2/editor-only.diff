+                backward=frame==null?0:frame.LastBackwardDistance,position=camera.transform.position,localPosition=camera.transform.localPosition,
+                euler=camera.transform.eulerAngles,lossyScale=camera.transform.lossyScale,parent=camera.transform.parent==null?"":camera.transform.parent.name};
+            if(frame!=null) foreach(string field in new[]{"basePosition","lastAppliedPosition","authoredLocalPosition","authoredLocalRotation","lastAppliedRotation","hasApplied","refreshAt"})
+            { var info=typeof(RecoveredBoardFraming).GetField(field,BindingFlags.Instance|BindingFlags.NonPublic); result.framingFields.Add(field+"="+(info==null?"missing":Convert.ToString(info.GetValue(frame)))); }
+            foreach(Renderer renderer in renderers)
+            {
+                MeshFilter filter=renderer.GetComponent<MeshFilter>(); Mesh mesh=filter.sharedMesh;
+                var item=new DetailMesh {path=renderer.name,worldCenter=renderer.bounds.center,worldSize=renderer.bounds.size,localScale=renderer.transform.lossyScale,minDepth=Single.MaxValue,maxDepth=Single.MinValue};
+                for(Transform parent=renderer.transform.parent;parent!=null;parent=parent.parent) item.path=parent.name+"/"+item.path;
+                foreach(Vector3 vertex in mesh.vertices)
+                {
+                    Vector3 point=camera.WorldToViewportPoint(filter.transform.TransformPoint(vertex));item.vertices++;
+                    item.minDepth=Mathf.Min(item.minDepth,point.z);item.maxDepth=Mathf.Max(item.maxDepth,point.z);
+                    if(point.z<camera.nearClipPlane)item.beforeNear++; if(point.z>camera.farClipPlane)item.beyondFar++;
+                    if(point.x<0||point.x>1||point.y<0||point.y>1)item.outsideXY++;
+                }
+                result.meshes.Add(item);
+            }
+            File.WriteAllText(Path.Combine(Output,"detail-camera-gm"+entry.assetId+"-"+(solution?"solution":"initial")+"-"+Mathf.RoundToInt(ratio*1000)+".json"),JsonUtility.ToJson(result,true));
