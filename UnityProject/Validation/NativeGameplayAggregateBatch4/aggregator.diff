+def exact_visual_scroll_approval(approval: Any, parent: Path) -> dict[str, Any]:
+    """Verify the complete reviewed hunk and the already actual-passed UV run."""
+    ensure(isinstance(approval, dict), "Invalid exact UV evidence")
+    ensure(approval.get("ruleId") == UV_RULE and approval.get("path") == UV_PATH
+           and approval.get("baseSha256") == UV_BASE_SHA
+           and approval.get("otherSha256") == UV_OTHER_SHA
+           and approval.get("mode0Unchanged") is True,
+           "Exact UV exception only accepts the reviewed WaterMotion source pair")
+    def blob(key: str, expected: str | None = None) -> tuple[Path, str]:
+        item = approval.get(key)
+        evidence_blob(item, parent)
+        path = (parent / item["path"]).resolve()
+        digest = hashlib.sha256(path.read_bytes()).hexdigest()
+        ensure(expected is None or digest == expected, "Exact UV " + key + " is not reviewed evidence")
+        return path, path.read_text("utf-8-sig")
+    before_path, before = blob("baseSource", UV_BASE_SHA)
+    after_path, after = blob("otherSource", UV_OTHER_SHA)
+    # Reconstruct the only permitted source transformation. This also excludes
+    # edits to LateUpdate timing, animator, particle, water or gameplay behavior.
+    begin = "                Material material = renderer.sharedMaterial;\n"
+    added = ("                // Original scrollTest1.Start1060C98 and Update1060CC0:\n"
+             "                // Start resolves Y; Update replaces, rather than adds to, the material offset.\n"
+             "                if (original.tipoOffset == 1) original.offsetInicialY = 0f;\n"
+             "                else if (original.tipoOffset == 2) original.offsetInicialY = .5f;\n")
+    old_offset = "offset = material.mainTextureOffset + new Vector2(original.offsetInicialX, original.offsetInicialY)"
+    new_offset = "offset = new Vector2(original.offsetInicialX, original.offsetInicialY)"
+    ensure(before.count(begin) == 1 and before.count(old_offset) == 1,
+           "Exact UV base syntax differs")
+    ensure(before.replace(begin, begin + added).replace(old_offset, new_offset) == after,
+           "Exact UV source has edits outside the reviewed scroll hunk")
+    _, diff = blob("fullDiff")
+    expected_diff = "".join(difflib.unified_diff(before.splitlines(True), after.splitlines(True),
+        fromfile=UV_PATH + " (frozen base)", tofile=UV_PATH + " (native UV only)"))
+    ensure(diff == expected_diff, "Exact UV full diff is incomplete or differs")
+    for key, expected_sha in UV_ASM_SHA.items():
+        blob(key, expected_sha)
+    report_path, report, report_sha = evidence_file(approval.get("actualUvValidation"), parent)
+    ensure(report_sha == UV_ACTUAL_REPORT_SHA, "Exact UV requires the reviewed actual passed Unity fixture")
+    started = timestamp(report.get("startedUtc"), "UV startedUtc")
+    finished = timestamp(report.get("finishedUtc"), "UV finishedUtc")
+    ensure(finished >= started and report.get("unityVersion") == UNITY
+           and report.get("runtimeSourceSha256") == UV_OTHER_SHA
+           and report.get("passed") is True and report.get("errors") == []
+           and all(report.get(key) is True for key in ("timeScaleRestored", "preferencesRestored", "enteredEditMode"))
+           and all(report.get(key) == 4 for key in ("originalTimeScale", "restoredTimeScale", "serializedTimeManagerScale")),
+           "Exact UV fixture did not pass and restore actual Editor/time/preferences")
+    checks = report.get("checks")
+    ensure(isinstance(checks, list) and len(checks) == 436
+           and all(isinstance(check, dict) and check.get("passed") is True for check in checks),
+           "Exact UV fixture checks incomplete")
+    names = {check.get("name") for check in checks}
+    ensure({"MatGr16-half-period-material-offset-ignored", "MatGr16_2-half-period-material-offset-ignored",
+            "multiple-rendered-frames-observed", "native-scaled-Time.time-at-scales1-and4",
+            "time-scale-restored-after-EnteredEditMode"} <= names, "Exact UV key coverage absent")
+    samples = report.get("samples")
+    ensure(isinstance(samples, list) and len(samples) == 420, "Exact UV post-render samples incomplete")
+    maximum_error = 0.0
+    for sample in samples:
+        expected_x = sample["initial"]["x"] + sample["speed"]["x"] * sample["time"]
+        expected_y = sample["initial"]["y"] + sample["speed"]["y"] * sample["time"]
+        error = max(abs(sample["actualST"]["z"] - expected_x), abs(sample["actualST"]["w"] - expected_y))
+        ensure(math.isfinite(error) and error <= 1e-4, "Exact UV actual MPB disagrees with original formula")
+        maximum_error = max(maximum_error, error)
+    ensure({sample["timeScale"] for sample in samples} >= {1.0, 4.0}, "Exact UV lacks both actual time scales")
+    return {**approval, "verifiedRuleId": UV_RULE, "actualReportPath": str(report_path),
+            "actualReportSha256": report_sha, "actualReportFinishedUtc": report["finishedUtc"],
+            "actualChecks": len(checks), "actualPostRenderSamples": len(samples),
+            "independentFormulaMaximumError": maximum_error,
+            "scope": "Only the exact scroll visual hunk; all other WaterMotion/source/physics differences stay strict."}
